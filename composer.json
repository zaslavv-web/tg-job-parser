{
    "name": "growthpeak/tg-job-parser",
    "description": "Парсер вакансий из Telegram-каналов и сайтов с генерацией сопроводительных писем",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-dom": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "anthropic-ai/sdk": "^0.51.0",
        "guzzlehttp/guzzle": "^8.2"
    },
    "suggest": {
        "ext-curl": "HTTP-клиент для парсинга t.me/s, RSS и сайтов",
        "ext-pdo_sqlite": "Хранилище по умолчанию"
    },
    "autoload": {
        "psr-4": {
            "TgJobParser\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TgJobParser\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "php tests/run.php",
        "migrate": "php bin/console migrate"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.2.0"
        }
    }
}
