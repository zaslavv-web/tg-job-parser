# Скопируйте в .env (файл не коммитится) или задайте переменные окружения процесса.

# --- Хранилище ---
# По умолчанию SQLite в var/db/database.sqlite. Для MySQL:
# DB_DSN=mysql:host=127.0.0.1;dbname=tg_jobs;charset=utf8mb4
# DB_USER=
# DB_PASSWORD=
DB_DSN=

# --- AI-генерация писем (опционально; без ключей работает шаблонный режим) ---
# Режим по умолчанию: template | claude | openai
LETTER_MODE=template
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-opus-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Telethon (приватные каналы, этап 7) ---
TG_API_ID=
TG_API_HASH=
TG_SESSION=var/telethon/session
TELETHON_PYTHON=python3

# --- Уведомления о рекомендуемых вакансиях (этап 8) ---
NOTIFY_TELEGRAM_BOT_TOKEN=
NOTIFY_TELEGRAM_CHAT_ID=

# --- Веб-интерфейс ---
# Если задан — UI требует HTTP Basic-авторизацию (логин любой).
APP_PASSWORD=
